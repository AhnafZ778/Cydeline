{
  "$defs": {
    "AccessOutcome": {
      "description": "Measured target result vocabulary, shared with the red-agent.",
      "enum": [
        "allowed",
        "denied",
        "listed",
        "probed",
        "none",
        "error",
        "unknown"
      ],
      "title": "AccessOutcome",
      "type": "string"
    },
    "EventType": {
      "description": "Canonical event type names rendered in the learner-visible feed.",
      "enum": [
        "run.created",
        "run.started",
        "run.completed",
        "run.reset",
        "session.status",
        "session.revoked",
        "session.reauth_required",
        "document.list",
        "document.access",
        "account.disabled",
        "account.restored",
        "benign.workflow",
        "agent.decision",
        "declaration.submitted",
        "verification.check",
        "score.computed"
      ],
      "title": "EventType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Target-local audit record; observed evidence, not a learner alert.",
  "properties": {
    "action": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Action"
    },
    "actor_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,31}$",
      "title": "Actor Id",
      "type": "string"
    },
    "audit_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
      "title": "Audit Id",
      "type": "string"
    },
    "correlation_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
      "title": "Correlation Id",
      "type": "string"
    },
    "detail": {
      "additionalProperties": true,
      "title": "Detail",
      "type": "object"
    },
    "event_type": {
      "$ref": "#/$defs/EventType"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "outcome": {
      "$ref": "#/$defs/AccessOutcome"
    },
    "resource_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,31}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resource Id"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "session_handle": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,31}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Handle"
    }
  },
  "required": [
    "audit_id",
    "run_id",
    "correlation_id",
    "occurred_at",
    "actor_id",
    "event_type",
    "outcome"
  ],
  "title": "TargetAuditEntry",
  "type": "object"
}
