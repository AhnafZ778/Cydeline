{
  "$defs": {
    "NetworkTelemetry": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bytes"
        },
        "http_method": {
          "title": "Http Method",
          "type": "string"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "number"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "src_ip": {
          "title": "Src Ip",
          "type": "string"
        },
        "status_code": {
          "maximum": 599,
          "minimum": 100,
          "title": "Status Code",
          "type": "integer"
        },
        "user_agent": {
          "title": "User Agent",
          "type": "string"
        }
      },
      "required": [
        "src_ip",
        "user_agent",
        "http_method",
        "path",
        "status_code",
        "latency_ms"
      ],
      "title": "NetworkTelemetry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actor_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,31}$",
      "title": "Actor Id",
      "type": "string"
    },
    "agent_meta": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agent Meta"
    },
    "correlation_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
      "title": "Correlation Id",
      "type": "string"
    },
    "decision_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decision Id"
    },
    "event_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "title": "Event Type",
      "type": "string"
    },
    "learner_visible": {
      "default": true,
      "title": "Learner Visible",
      "type": "boolean"
    },
    "network": {
      "anyOf": [
        {
          "$ref": "#/$defs/NetworkTelemetry"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "outcome": {
      "anyOf": [
        {
          "enum": [
            "allowed",
            "denied",
            "listed",
            "probed",
            "none",
            "error",
            "unknown",
            "applied",
            "verified",
            "failed"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Outcome"
    },
    "parent_event_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Event Id"
    },
    "resource_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,31}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resource Id"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "session_handle": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,31}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Handle"
    },
    "source": {
      "enum": [
        "target-access",
        "control-plane",
        "system",
        "model",
        "defender",
        "red-agent",
        "control-defender"
      ],
      "title": "Source",
      "type": "string"
    },
    "target_audit_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Audit Id"
    },
    "timestamp_utc": {
      "format": "date-time",
      "title": "Timestamp Utc",
      "type": "string"
    },
    "virtual_clock_sec": {
      "minimum": 0,
      "title": "Virtual Clock Sec",
      "type": "number"
    },
    "visible_at_utc": {
      "format": "date-time",
      "title": "Visible At Utc",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "run_id",
    "sequence",
    "timestamp_utc",
    "visible_at_utc",
    "source",
    "event_type",
    "actor_id",
    "correlation_id",
    "virtual_clock_sec"
  ],
  "title": "LiveEvent",
  "type": "object"
}
