{
  "$defs": {
    "SavedQuery": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "query": {
          "maxLength": 1000,
          "title": "Query",
          "type": "string"
        }
      },
      "required": [
        "name",
        "query"
      ],
      "title": "SavedQuery",
      "type": "object"
    },
    "TimelineEntry": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
          "title": "Event Id",
          "type": "string"
        },
        "note": {
          "maxLength": 2000,
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "note"
      ],
      "title": "TimelineEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "evidence_ids": {
      "anyOf": [
        {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
            "type": "string"
          },
          "maxItems": 100,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence Ids"
    },
    "hypothesis": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Hypothesis"
    },
    "hypothesis_status": {
      "anyOf": [
        {
          "enum": [
            "open",
            "supported",
            "rejected"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Hypothesis Status"
    },
    "note": {
      "anyOf": [
        {
          "maxLength": 20000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Note"
    },
    "revision": {
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "saved_queries": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/SavedQuery"
          },
          "maxItems": 50,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Saved Queries"
    },
    "timeline": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/TimelineEntry"
          },
          "maxItems": 100,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Timeline"
    }
  },
  "required": [
    "revision"
  ],
  "title": "WorkspacePatch",
  "type": "object"
}
