{
  "$defs": {
    "Verification": {
      "description": "The two mandatory, independently measured recovery probes.",
      "enum": [
        "verify_suspicious_session_denied",
        "verify_benign_workflow"
      ],
      "title": "Verification",
      "type": "string"
    },
    "VerificationCheck": {
      "additionalProperties": false,
      "description": "One independently measured recovery probe.",
      "properties": {
        "checked_at": {
          "format": "date-time",
          "title": "Checked At",
          "type": "string"
        },
        "measured_result": {
          "additionalProperties": true,
          "title": "Measured Result",
          "type": "object"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "target_audit_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
          "title": "Target Audit Id",
          "type": "string"
        },
        "verification": {
          "$ref": "#/$defs/Verification"
        }
      },
      "required": [
        "verification",
        "passed",
        "measured_result",
        "target_audit_id",
        "checked_at"
      ],
      "title": "VerificationCheck",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Both mandatory probes. A single passing check is not recovery.",
  "properties": {
    "all_passed": {
      "title": "All Passed",
      "type": "boolean"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/VerificationCheck"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Checks",
      "type": "array"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "verified_at": {
      "format": "date-time",
      "title": "Verified At",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "checks",
    "all_passed",
    "verified_at"
  ],
  "title": "VerificationResponse",
  "type": "object"
}
