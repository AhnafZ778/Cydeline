{
  "$defs": {
    "DefenderAction": {
      "description": "Closed defender action enum accepted from the learner browser.",
      "enum": [
        "revoke_session",
        "temporarily_disable_account",
        "require_reauthentication",
        "restore_account"
      ],
      "title": "DefenderAction",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Idempotent containment request from the learner browser.",
  "properties": {
    "action": {
      "$ref": "#/$defs/DefenderAction"
    },
    "idempotency_key": {
      "pattern": "^[A-Za-z0-9_.:-]{8,128}$",
      "title": "Idempotency Key",
      "type": "string"
    },
    "rationale": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rationale"
    },
    "target_handle": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,31}$",
      "title": "Target Handle",
      "type": "string"
    }
  },
  "required": [
    "action",
    "target_handle",
    "idempotency_key"
  ],
  "title": "DefenderActionRequest",
  "type": "object"
}
