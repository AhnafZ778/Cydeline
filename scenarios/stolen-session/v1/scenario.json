    "domain": "northstar.test",
    "note": "Reserved fictional identity. All users, documents and contents are synthetic."
  },
  "defaults": {
    "mode": "practice",
    "seed": 20261022,
    "max_attacker_steps": 6,
    "turn_timeout_seconds": 20,
    "virtual_clock": "scenario",
    "exclude_model_inference_from_timing": true
  },
  "users": [
    {
      "user_id": "maya",
