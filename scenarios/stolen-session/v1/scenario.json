    },
    {
      "offset_seconds": 5,
      "event_type": "document.list",
      "source": "target-access",
      "actor_id": "eli",
      "session_handle": "sess_eli",
      "outcome": "listed",
      "description": "Routine document listing."
    },
    {
      "offset_seconds": 9,
      "event_type": "document.access",
      "source": "target-access",
      "actor_id": "eli",
      "session_handle": "sess_eli",
      "resource_id": "doc_ops_02",
      "outcome": "allowed",
      "description": "Eli opens the operations runbook."
    },
    {
      "offset_seconds": 12,
      "event_type": "session.status",
      "source": "target-access",
      "actor_id": "unknown",
      "session_handle": "sess_unknown",
      "outcome": "denied",
      "description": "Unrelated failed sign-in."
    }
  ],
  "pacing": {
    "minimum_signals_before_first_protected_read": 2,
    "minimum_virtual_seconds_before_first_protected_read": 20,
    "disclose_simulated_pacing": true
  },
  "verification": {
    "required_checks": [
      "verify_suspicious_session_denied",
      "verify_benign_workflow"
