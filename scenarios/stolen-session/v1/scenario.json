  "hidden_ground_truth": {
    "visibility": "server_only",
    "do_not_serve_to_browser_or_model": true,
    "compromised_session": "sess_A",
    "compromised_user": "maya",
    "protected_resource": "doc_finance_07",
    "benign_user": "eli",
