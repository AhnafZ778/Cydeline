FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && mkdir /data && chown 65532:65532 /data
COPY contracts contracts
COPY services services
COPY apps/target-api apps/target-api
COPY scenarios scenarios
ENV PYTHONPATH=/app TARGET_DB=/data/target.sqlite3
USER 65532:65532
CMD ["python","-m","uvicorn","apps.target-api.main:app","--host","0.0.0.0","--port","8001"]
