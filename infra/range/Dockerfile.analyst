FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive DISPLAY=:1
# The package layer is the slow, network-bound step, so it is kept separate from account creation (stays cacheable)
# and is resilient to a slow mirror: retries, generous timeouts, and a hard failure on any missing package index
# rather than a misleading "unable to locate package" later.
RUN printf 'Acquire::Retries "6";\nAcquire::http::Timeout "60";\nAcquire::https::Timeout "60";\nAPT::Update::Error-Mode "any";\n' > /etc/apt/apt.conf.d/80-cydeline-network \
 && for attempt in 1 2 3 4; do apt-get update && break; [ "$attempt" = 4 ] && exit 1; sleep 10; done \
 && apt-get install -y --no-install-recommends xfce4 xfce4-terminal dbus-x11 tigervnc-standalone-server epiphany-browser mousepad curl jq python3 tshark iproute2 tini \
 && rm -rf /var/lib/apt/lists/*
# ubuntu:24.04 already owns UID/GID 1000 (the "ubuntu" account), so the analyst account must use a different id.
RUN useradd -m -u 1001 -s /bin/bash analyst
COPY infra/range/start-desktop.sh /usr/local/bin/start-desktop
RUN chmod 755 /usr/local/bin/start-desktop
USER 1001:1001
WORKDIR /home/analyst
ENTRYPOINT ["/usr/bin/tini","--","/usr/local/bin/start-desktop"]
